---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'nl';
---

<BaseLayout lang={lang} title="Pagina niet gevonden">
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center">
      <span class="text-8xl font-display font-bold text-accent">404</span>
      <h1 class="font-display text-3xl font-bold text-primary dark:text-white mt-4 mb-4">Pagina niet gevonden</h1>
      <p class="text-text-light dark:text-gray-400 mb-8">De pagina die u zoekt bestaat niet of is verplaatst.</p>
      <a href="/nl/" class="inline-flex items-center px-6 py-3 bg-accent text-white font-semibold rounded-xl hover:bg-accent-light transition-colors">
        Terug naar home
      </a>
    </div>
  </main>
</BaseLayout>
