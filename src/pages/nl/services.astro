---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../i18n/translations';

const lang = 'nl';
const t = (key: string) => ui.nl[key as keyof typeof ui.nl];
---

<BaseLayout lang={lang} title={t('nav.services') + ' — ' + t('site.title')}>
  <Header lang={lang} />
  <main class="pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="font-display text-4xl font-bold text-primary dark:text-white mb-4">{t('nav.services')}</h1>
        <p class="text-text-light dark:text-gray-400 max-w-2xl mx-auto">{t('services.subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        <div class="p-8 rounded-2xl border border-gray-100 dark:border-gray-800 hover:shadow-lg transition-all">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h2 class="font-display text-xl font-semibold text-primary dark:text-white mb-3">{t('services.web')}</h2>
          <p class="text-text-light dark:text-gray-400 mb-4">{t('services.web.desc')}</p>
          <ul class="space-y-2 text-sm text-text-light dark:text-gray-400">
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Responsive design</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> SEO-optimalisatie</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> SSL-certificaat</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Beheersysteem inbegrepen</li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl border border-gray-100 dark:border-gray-800 hover:shadow-lg transition-all">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
          </div>
          <h2 class="font-display text-xl font-semibold text-primary dark:text-white mb-3">{t('services.seo')}</h2>
          <p class="text-text-light dark:text-gray-400 mb-4">{t('services.seo.desc')}</p>
          <ul class="space-y-2 text-sm text-text-light dark:text-gray-400">
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Technische SEO audit</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Keyword onderzoek</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Content optimalisatie</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Lokale SEO (Google Maps)</li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl border border-gray-100 dark:border-gray-800 hover:shadow-lg transition-all">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          </div>
          <h2 class="font-display text-xl font-semibold text-primary dark:text-white mb-3">{t('services.maintenance')}</h2>
          <p class="text-text-light dark:text-gray-400 mb-4">{t('services.maintenance.desc')}</p>
          <ul class="space-y-2 text-sm text-text-light dark:text-gray-400">
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Maandelijkse updates</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> 24/7 monitoring</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Backup & beveiliging</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Inhoud aanpassingen</li>
          </ul>
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Diensten',
  description: 'Onze webdesign en SEO diensten voor het Nederlandse bedrijfsleven.',
})}></script>
