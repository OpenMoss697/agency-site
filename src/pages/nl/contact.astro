---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../i18n/translations';

const lang = 'nl';
const t = (key: string) => ui.nl[key as keyof typeof ui.nl];
---

<BaseLayout lang={lang} title={t('nav.contact') + ' — ' + t('site.title')}>
  <Header lang={lang} />
  <main class="pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <h1 class="font-display text-4xl font-bold text-primary dark:text-white mb-4">{t('nav.contact')}</h1>
          <p class="text-text-light dark:text-gray-400 mb-8 text-lg">{t('contact.subtitle')}</p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h3 class="font-medium text-primary dark:text-white">E-mail</h3>
                <p class="text-text-light dark:text-gray-400">info@example.nl</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h3 class="font-medium text-primary dark:text-white">Telefoon</h3>
                <p class="text-text-light dark:text-gray-400">+31 6 12345678</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h3 class="font-medium text-primary dark:text-white">Adres</h3>
                <p class="text-text-light dark:text-gray-400">Hoofdstraat 123<br />1234 AB Amsterdam<br />Nederland</p>
              </div>
            </div>
          </div>
        </div>

        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="bg-white dark:bg-surface-dark rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-800">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>Niet invullen: <input name="bot-field" /></label></p>

          <div class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-primary dark:text-white mb-2">{t('contact.name')}</label>
              <input type="text" name="name" required class="w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 text-primary dark:text-white focus:ring-2 focus:ring-accent focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-primary dark:text-white mb-2">{t('contact.email')}</label>
              <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 text-primary dark:text-white focus:ring-2 focus:ring-accent focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-primary dark:text-white mb-2">{t('contact.phone')}</label>
              <input type="tel" name="phone" class="w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 text-primary dark:text-white focus:ring-2 focus:ring-accent focus:border-transparent outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-primary dark:text-white mb-2">{t('contact.message')}</label>
              <textarea name="message" rows="5" required class="w-full px-4 py-3 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 text-primary dark:text-white focus:ring-2 focus:ring-accent focus:border-transparent outline-none resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-accent text-white font-semibold rounded-xl hover:bg-accent-light transition-all">{t('contact.send')}</button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
