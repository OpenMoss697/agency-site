---
import { t as translate } from '../i18n/utils';

const { lang } = Astro.props as { lang: string };
const t = (key: string) => translate(key, lang);

const steps = [
  { num: '01', icon: 'target', title: t('process.step1.title'), desc: t('process.step1.desc') },
  { num: '02', icon: 'design', title: t('process.step2.title'), desc: t('process.step2.desc') },
  { num: '03', icon: 'launch', title: t('process.step3.title'), desc: t('process.step3.desc') },
];
---

<section id="process" class="py-20 bg-surface dark:bg-gray-900 relative overflow-hidden">
  <!-- Background dot pattern -->
  <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.015]" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px;"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-20">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary dark:text-white mb-4">
        {t('process.title')}
      </h2>
      <p class="text-text-light dark:text-gray-400 max-w-2xl mx-auto">
        {t('process.subtitle')}
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-accent via-accent/50 to-accent/10 md:-translate-x-px"></div>

      {steps.map((step, i) => (
        <div class={`relative flex flex-col md:flex-row items-start mb-16 last:mb-0 gap-6 md:gap-12 ${
          i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'
        }`}>
          {/* Timeline dot */}
          <div class="absolute left-8 md:left-1/2 -translate-x-1/2 z-10">
            <div class="w-16 h-16 bg-accent rounded-2xl flex items-center justify-center shadow-lg shadow-accent/25 rotate-3 group-hover:rotate-6 transition-transform">
              <span class="font-display text-2xl font-bold text-white">{step.num}</span>
            </div>
          </div>

          {/* Spacer for timeline alignment */}
          <div class="hidden md:block md:w-1/2"></div>

          {/* Content card */}
          <div class="md:w-1/2 ml-20 md:ml-0 pt-20 md:pt-0">
            <div class={`group bg-white dark:bg-surface-dark rounded-2xl p-6 border border-gray-100 dark:border-gray-800 hover:border-accent/30 dark:hover:border-accent/30 hover:shadow-lg transition-all duration-300 ${
              i % 2 === 0 ? 'md:mr-8' : 'md:ml-8'
            }`}>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-accent/20 transition-colors">
                  {step.icon === 'target' && (
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  )}
                  {step.icon === 'design' && (
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                  )}
                  {step.icon === 'launch' && (
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  )}
                </div>
                <div>
                  <h3 class="font-display text-lg font-semibold text-primary dark:text-white mb-2">{step.title}</h3>
                  <p class="text-text-light dark:text-gray-400 text-sm leading-relaxed">{step.desc}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
