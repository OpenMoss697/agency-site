---
import { t as translate } from '../i18n/utils';

const { lang } = Astro.props as { lang: string };
const t = (key: string) => translate(key, lang);

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
];
---

<section id="faq" class="py-20 bg-white dark:bg-surface-dark">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary dark:text-white mb-4">
        {t('faq.title')}
      </h2>
      <p class="text-text-light dark:text-gray-400">{t('faq.subtitle')}</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="group border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
            <span class="font-medium text-primary dark:text-white pr-4">{faq.q}</span>
            <svg class="w-5 h-5 shrink-0 text-text-light group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-text-light dark:text-gray-400 leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
