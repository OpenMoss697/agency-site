---
import { t as translate } from '../i18n/utils';

const { lang } = Astro.props as { lang: string };
const t = (key: string) => translate(key, lang);

const projects = [
  { title: 'Bouwbedrijf De Vries', category: 'Bouw', image: 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=600&h=400&fit=crop' },
  { title: 'Zorgcentrum Linde', category: 'Zorg', image: 'https://images.unsplash.com/photo-1551076805-e1869033e561?w=600&h=400&fit=crop' },
  { title: 'Advocatenkantoor Smit', category: 'Juridisch', image: 'https://images.unsplash.com/photo-1447968954315-3f0c44f7313c?w=600&h=400&fit=crop' },
  { title: 'Restaurant De Haven', category: 'Horeca', image: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=600&h=400&fit=crop' },
  { title: 'Tech Solutions BV', category: 'IT', image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=400&fit=crop' },
  { title: 'Bloemist Fleur', category: 'Retail', image: 'https://images.unsplash.com/photo-1563241527-3004b7be0ffd?w=600&h=400&fit=crop' },
];
---

<section id="portfolio" class="py-20 bg-surface dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary dark:text-white mb-4">
        {t('portfolio.title')}
      </h2>
      <p class="text-text-light dark:text-gray-400 max-w-2xl mx-auto">
        {t('portfolio.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="group relative overflow-hidden rounded-2xl bg-white dark:bg-surface-dark shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[3/2] overflow-hidden">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-4">
            <p class="text-xs font-medium text-accent uppercase tracking-wider mb-1">{project.category}</p>
            <h3 class="font-display font-semibold text-primary dark:text-white">{project.title}</h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
