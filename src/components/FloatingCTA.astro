---
import { t as translate } from '../i18n/utils';

const { lang } = Astro.props as { lang: string };
const t = (key: string) => translate(key, lang);
---

<a
  href={`/${lang}/contact`}
  class="fixed bottom-6 right-6 z-50 lg:hidden flex items-center gap-2 px-6 py-3.5 bg-accent text-white font-bold rounded-full shadow-lg shadow-accent/30 hover:bg-accent-light transition-all duration-300 hover:scale-105 active:scale-95"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
  </svg>
  {t('hero.cta')}
</a>
