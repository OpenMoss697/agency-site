---
const { lang } = Astro.props as { lang: string };
const currentPath = Astro.url.pathname;
const altLang = lang === 'nl' ? 'en' : 'nl';
const altPath = currentPath.replace(`/${lang}/`, `/${altLang}/`);
---

<a
  href={altPath}
  hreflang={altLang}
  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-semibold text-primary dark:text-white hover:bg-accent hover:text-white dark:hover:bg-accent transition-all duration-200 border border-gray-200 dark:border-gray-700 hover:border-accent"
  title={altLang === 'en' ? 'English' : 'Nederlands'}
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
  </svg>
  <span class="hidden sm:inline">{lang === 'nl' ? 'EN' : 'NL'}</span>
</a>
