---
import { t as translate } from '../i18n/utils';

const { lang } = Astro.props as { lang: string };
const t = (key: string) => translate(key, lang);
---

<footer class="bg-primary dark:bg-gray-950 text-white mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-8 h-8 bg-accent rounded-lg flex items-center justify-center text-white text-sm font-bold">W</span>
          <span class="font-display font-bold text-lg">{t('site.title')}</span>
        </div>
        <p class="text-gray-300 max-w-md">{t('site.description')}</p>
      </div>

      <div>
        <h4 class="font-semibold mb-4">{t('nav.services')}</h4>
        <ul class="space-y-2 text-gray-300 text-sm">
          <li><a href={`/${lang}/services`} class="hover:text-accent transition-colors">{t('services.web')}</a></li>
          <li><a href={`/${lang}/services`} class="hover:text-accent transition-colors">{t('services.seo')}</a></li>
          <li><a href={`/${lang}/services`} class="hover:text-accent transition-colors">{t('services.maintenance')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">{t('nav.contact')}</h4>
        <ul class="space-y-2 text-gray-300 text-sm">
          <li><a href={`/${lang}/contact`} class="hover:text-accent transition-colors">{t('contact.title')}</a></li>
          <li><a href={`/${lang}/faq`} class="hover:text-accent transition-colors">{t('faq.title')}</a></li>
          <li><a href={`/${lang}/privacy`} class="hover:text-accent transition-colors">{t('footer.privacy')}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-700 mt-8 pt-8 text-center text-gray-400 text-sm">
      <p>&copy; {new Date().getFullYear()} {t('site.title')}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>
