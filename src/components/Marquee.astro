---
import { t as translate } from '../i18n/utils';

const { lang } = Astro.props as { lang: string };
const t = (key: string) => translate(key, lang);
---

<div class="py-8 bg-primary dark:bg-gray-950 border-y border-white/5 overflow-hidden relative">
  <div class="absolute inset-0 bg-primary/20 dark:bg-gray-950/20 backdrop-blur-[1px] z-10 pointer-events-none"></div>
  <div class="flex flex-shrink-0 gap-16 animate-marquee">
    {[...Array(2)].map(() => (
      <span class="text-lg md:text-xl font-display font-bold text-transparent bg-clip-text bg-gradient-to-r from-white/50 to-white/30 whitespace-nowrap">
        {t('marquee.services')} &nbsp;•&nbsp;
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
</style>
